{
  // Root project: repo-level Node scripts, the Vitest/Playwright configs and the e2e tests
  // (which also run code in the page — hence DOM). Each workspace has its own tsconfig;
  // `npm run typecheck` checks this one and then every workspace.
  "extends": "./tsconfig.base.json",
  "compilerOptions": { "lib": ["ES2023", "DOM"], "types": ["node"] },
  "include": ["scripts", "e2e", "vitest.config.ts", "playwright.config.ts"]
}
