# Copy to server/.env (loaded by `node --env-file-if-exists=.env`). All values are optional;
# every one is validated at startup (server/src/config.ts) — a bad value stops the server with a
# clear message. In production these come from the platform (Render → Environment), never git.
NODE_ENV=development
PORT=8787
# unset: 0.0.0.0 in production (reachable in a container), 127.0.0.1 otherwise
# HOST=127.0.0.1
# STATIC_DIR=../client/dist
# LOG_DIR=logs
LOG_LEVEL=info
MAX_ROOMS=20
MAX_PLAYERS_PER_ROOM=8
MAX_PAYLOAD_BYTES=4096
RATE_LIMIT_PER_SEC=10
RATE_LIMIT_BURST=20
JOIN_TIMEOUT_MS=5000
HEARTBEAT_MS=15000
SLOW_CLIENT_BYTES=262144
SHUTDOWN_TIMEOUT_MS=5000
# --- Lab 8: production ---
# Browser origins allowed to open a WebSocket, comma-separated. Empty = same origin only
# (plus localhost origins outside production). E.g. for an itch.io build:
# ALLOWED_ORIGINS=https://html-classic.itch.zone
MAX_CONNECTIONS_PER_IP=16
# true behind a platform proxy (Render, Fly…): the client IP comes from X-Forwarded-For
TRUST_PROXY=false
# The running commit, shown in /health and /metrics (Render sets RENDER_GIT_COMMIT itself)
# GIT_SHA=
# DEBUG_ROUTES=true   (default: true unless NODE_ENV=production)
